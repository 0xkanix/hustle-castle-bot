<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.autor</groupId>
    <artifactId>hustle-bot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- OpenCV mit gebundelten nativen Bibliotheken, kein manuelles DLL-Setup noetig -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!-- Windows-API: Spielfenster finden und vermessen -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>

        <!-- Tests (nur beim Bauen, landen nicht im Paket) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Autor 25.10.: PaddleOCR-Modelle (ONNX) ohne Python ausfuehren -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.22.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>hustle-bot</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>

            <!-- Fuehrt die Tests unter src/test aus (JUnit 5). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludes>
                        <exclude>**/SpeicherTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- 12.10.: Einstellungen setzen -> Neustart -> lesen, in einem eigenen Ordner
                         (sonst wuerden echte Einstellungs-Dateien ueberschrieben). -->
                    <execution>
                        <id>speicher-pruefung</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/SpeicherTest.java</include>
                            </includes>
                            <workingDirectory>${project.build.directory}/speicher-pruefung</workingDirectory>
                            <reportsDirectory>${project.build.directory}/surefire-reports-speicher</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.hustlebot.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!--
                                          OpenCV bringt seine Bibliotheken fuer sieben
                                          Plattformen mit, zusammen 269 MB. Ein Windows-PC
                                          mit 64 Bit braucht davon nur eine: 49,6 MB.
                                          Die Laufzeit im Paket ist ohnehin 64 Bit.
                                        -->
                                        <exclude>nu/pattern/opencv/linux/**</exclude>
                                        <exclude>nu/pattern/opencv/osx/**</exclude>
                                        <exclude>nu/pattern/opencv/windows/x86_32/**</exclude>
                                        <!-- ONNX Runtime (PaddleOCR): nur Windows 64 Bit, ohne Fehlersuch-Dateien (.pdb 357 MB) -->
                                        <exclude>ai/onnxruntime/native/linux-*/**</exclude>
                                        <exclude>ai/onnxruntime/native/osx-*/**</exclude>
                                        <exclude>ai/onnxruntime/native/**/*.pdb</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
